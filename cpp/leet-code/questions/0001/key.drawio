        <mxCell id="p3JC-J1vWyIUQEY2Gx-z-121" value="Round #1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3JC-J1vWyIUQEY2Gx-z-122" value="Round #2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" vertex="1" parent="1">
