+/* Added by Edison */
+LUA_API int lua_isKeyExistedWithNilValue(lua_State *L, int tIndex, int keyIndex)
+{
+    StkId t = index2adr(L, tIndex);
+    api_check(L, ttistable(t));
+    StkId key = index2adr(L, keyIndex);
+    int hasKeyWithNilValue = luaH_isKeyNil( hvalue(t), key);
+    return hasKeyWithNilValue;
+}
