+int luaH_isKeyNil (Table *t, const TValue *key)
+{
+    const TValue* ret = luaH_get (t,key);
+    if ( ret == luaO_nilobject ) {
+        return 0;
+    } else {
+        return (ttype(ret) == LUA_TNIL ? 1 : 0);
+    }
